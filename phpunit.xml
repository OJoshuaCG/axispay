<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against real MariaDB 11.8 (docker compose / CI service).
             Local Docker credentials; not secrets. -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_URL" value=""/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="33061"/>
        <env name="DB_DATABASE" value="paylink_testing"/>
        <env name="DB_USERNAME" value="paylink_app"/>
        <env name="DB_PASSWORD" value="paylink_app"/>
        <env name="DB_SOCKET" value=""/>
        <env name="PAYLINK_API_HOST" value="api.localhost"/>
        <env name="PAYLINK_APP_HOST" value="app.localhost"/>
        <env name="PAYLINK_ADMIN_HOST" value="admin.localhost"/>
        <env name="PAYLINK_PAY_HOST" value="pay.localhost"/>
        <!-- No network in tests: the breached-password check (HIBP) is off by
             default and enabled with Http::fake() where it is tested. -->
        <env name="PAYLINK_PASSWORD_CHECK_UNCOMPROMISED" value="false"/>
        <env name="LOG_CHANNEL" value="stack"/>
        <env name="LOG_STACK" value="single"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
