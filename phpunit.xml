<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Real Stripe test mode (group "stripe"): skipped unless STRIPE_TEST_SECRET is exported. -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- PHPStan rule tests (tests/Unit/PHPStan) boot the analyser and
             need more than the usual 128M CLI default. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against real MariaDB 11.8 (docker compose / CI service).
             Local Docker credentials; not secrets. -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_URL" value=""/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="33061"/>
        <env name="DB_DATABASE" value="axispay_testing"/>
        <env name="DB_USERNAME" value="axispay_app"/>
        <env name="DB_PASSWORD" value="axispay_app"/>
        <env name="DB_SOCKET" value=""/>
        <env name="AXISPAY_API_HOST" value="api.localhost"/>
        <env name="AXISPAY_APP_HOST" value="app.localhost"/>
        <env name="AXISPAY_ADMIN_HOST" value="admin.localhost"/>
        <env name="AXISPAY_PAY_HOST" value="pay.localhost"/>
        <!-- No network in tests: the breached-password check (HIBP) is off by
             default and enabled with Http::fake() where it is tested. -->
        <env name="AXISPAY_PASSWORD_CHECK_UNCOMPROMISED" value="false"/>
        <!-- Gateways (Phase 2): fixed dummy values; real Stripe keys never come from .env here. -->
        <env name="GATEWAY_CREDENTIALS_KEY" value="base64:exZjgPJOTGLGSZ4Sur4kxQZRO/RDy/sL2OHu7T7G2Wo="/>
        <env name="GATEWAY_CREDENTIALS_KEY_VERSION" value="1"/>
        <env name="GATEWAY_CREDENTIALS_PREVIOUS_KEYS" value=""/>
        <env name="STRIPE_TEST_SECRET" value=""/>
        <env name="STRIPE_TEST_PUBLISHABLE" value="pk_test_platform"/>
        <env name="STRIPE_LIVE_PUBLISHABLE" value="pk_live_platform"/>
        <env name="STRIPE_TEST_CONNECT_WEBHOOK_SECRET" value="whsec_testconnectsecret"/>
        <env name="STRIPE_LIVE_CONNECT_WEBHOOK_SECRET" value="whsec_liveconnectsecret"/>
        <env name="STRIPE_LIVE_SECRET" value="sk_live_platformdummy"/>
        <env name="AXISPAY_STRIPE_ALLOWED_COUNTRIES" value="MX"/>
        <!-- Contract tests (group "stripe") run only when STRIPE_TEST_SECRET is exported in the
             shell (an exported variable wins over these empty defaults; .env never does). -->
        <env name="LOG_CHANNEL" value="stack"/>
        <env name="LOG_STACK" value="single"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
