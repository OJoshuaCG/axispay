{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "brick/money": "^0.15.1",
        "filament/filament": "^5.8",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.10",
        "sentry/sentry-laravel": "^4.28",
        "spatie/laravel-permission": "^8.3",
        "stripe/stripe-php": "^21.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install --frozen-lockfile",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --exclude-group=concurrency"
        ],
        "test:concurrency": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --group=concurrency"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "format:check": [
            "@php vendor/bin/pint --test"
        ],
        "ci": [
            "@format:check",
            "@analyse",
            "@test",
            "@test:concurrency"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the Pest suite against the MariaDB configured in phpunit.xml (without the multi-process concurrency tests).",
        "test:concurrency": "Run the multi-process concurrency tests (they rebuild the test database).",
        "analyse": "Run Larastan (PHPStan level max).",
        "format": "Fix code style with Pint.",
        "format:check": "Check code style with Pint without changing files.",
        "ci": "Run format check, static analysis, tests and concurrency tests, as CI does."
    }
}
