# Fixed internal name (ADR-0037). It drives the cache, Redis and default
# session cookie prefixes: do not change it to rebrand.
APP_NAME=AxisPay
# Public name shown to people (layouts, panels, 2FA issuer, mail sender).
# Change this one to rebrand.
AXISPAY_DISPLAY_NAME=AxisPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local: plain text. Production container (ADR-0035): the image sets
# LOG_CHANNEL=stderr, LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter and
# LOG_LEVEL=info (redacted JSON lines on stderr, no files). On a server without
# containers use LOG_STACK=json (JSON files rotated daily, LOG_JSON_DAYS days).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_JSON_DAYS=30

# Breached-password check on new passwords (HIBP k-anonymity API, plan 17.3).
# AXISPAY_PASSWORD_CHECK_UNCOMPROMISED=true

# Surface hosts (ADR-027). Each surface is routed with Route::domain().
AXISPAY_ADMIN_HOST=admin.localhost
AXISPAY_APP_HOST=app.localhost
AXISPAY_PAY_HOST=pay.localhost
AXISPAY_API_HOST=api.localhost

# Public API (ADR-0048): requests per minute per API key, and the platform
# maximum per link in cents (USD 10,000.00 / MXN 200,000.00).
# AXISPAY_API_RATE_LIMIT_LIVE=100
# AXISPAY_API_RATE_LIMIT_TEST=100
# AXISPAY_API_FAILED_AUTH_PER_MINUTE=30
# AXISPAY_MAX_CHARGE_USD_MINOR=1000000
# AXISPAY_MAX_CHARGE_MXN_MINOR=20000000

# MariaDB 11.8 LTS (ADR-003, ADR-026). Local values match compose.yaml; in
# production point these at the external database server.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=axispay
DB_USERNAME=axispay_app
DB_PASSWORD=axispay_app
# Deploy-time migrations user (php artisan migrate --database=mariadb_migrator).
DB_MIGRATOR_USERNAME=axispay_migrator
DB_MIGRATOR_PASSWORD=axispay_migrator
# Optional TLS to an external server (paths readable by PHP).
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/axispay-db-ca.pem
# MYSQL_ATTR_SSL_CERT=
# MYSQL_ATTR_SSL_KEY=
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true
# Host port published by compose.yaml (default 33061).
# FORWARD_DB_PORT=33061

# Reverse proxies whose X-Forwarded-* headers are trusted (config/trustedproxy.php).
# Unset locally. Production behind Traefik (Dokploy): its network range, e.g.
# 10.0.0.0/8. Never "*" when the container port is reachable from outside.
# TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production (HTTPS): true, so session cookies are sent only over TLS.
# SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
# Must stay null: host-only cookies keep the admin and app sessions apart
# (ADR-0034). The app refuses to boot with a shared parent domain.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${AXISPAY_DISPLAY_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking (Sentry or GlitchTip, ADR-029). Disabled while empty.
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Stripe (plan 12.2, ADR-0047). Test and live keys are separate and never mixed.
# The Connect webhook secrets belong to the Connect endpoints registered in the
# platform's Stripe Dashboard: https://<api host>/webhooks/stripe/connect/{test|live}
STRIPE_TEST_SECRET=
STRIPE_TEST_PUBLISHABLE=
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET=
STRIPE_LIVE_PUBLISHABLE=
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=
# OAuth (Phase 4B, disabled): STRIPE_TEST_CONNECT_CLIENT_ID= / STRIPE_LIVE_CONNECT_CLIENT_ID=
# Countries a connected account may be in (comma-separated ISO codes; first = default).
AXISPAY_STRIPE_ALLOWED_COUNTRIES=MX
# AXISPAY_STRIPE_PLATFORM_ONBOARDING=true
# AXISPAY_STRIPE_API_KEY_CONNECTIONS=true

# Dedicated key for merchant Stripe credentials (api_key method). NOT APP_KEY.
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Back it up separately from APP_KEY and from database backups.
GATEWAY_CREDENTIALS_KEY=
GATEWAY_CREDENTIALS_KEY_VERSION=1
# After a rotation: comma-separated "<version>:<key>" of the old keys.
GATEWAY_CREDENTIALS_PREVIOUS_KEYS=

VITE_APP_NAME="${AXISPAY_DISPLAY_NAME}"

# Production container only (Dockerfile, docs/deployment/dokploy.md).
# CONTAINER_ROLE=web            # web | worker | scheduler | release | all-in-one
#                               # all-in-one: web + workers + scheduler under
#                               # supervisord, staging/local only (ADR-0039)
# RUN_MIGRATIONS=false          # true on the web service: migrate before serving
# RELEASE_SEED=true             # seed the permission catalog after migrating
# WAIT_FOR_MIGRATIONS=true      # other roles wait until no migration is pending
# MIGRATIONS_WAIT_SECONDS=300
# DB_WAIT_SECONDS=60
# PHP_FPM_MAX_CHILDREN=10
# QUEUE_NAMES=critical,default,low
# QUEUE_TIMEOUT=60
# QUEUE_TRIES=3
# QUEUE_SLEEP=3
# QUEUE_MEMORY=192
