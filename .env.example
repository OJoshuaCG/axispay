APP_NAME="Cirox Payments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Local: plain text. Production: LOG_STACK=json (structured JSON, redacted,
# rotated daily; keep LOG_JSON_DAYS days) and LOG_LEVEL=info.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_JSON_DAYS=30

# Surface hosts (ADR-027). Each surface is routed with Route::domain().
PAYLINK_ADMIN_HOST=admin.localhost
PAYLINK_APP_HOST=app.localhost
PAYLINK_PAY_HOST=pay.localhost
PAYLINK_API_HOST=api.localhost

# MariaDB 11.8 LTS (ADR-003, ADR-026). Local values match compose.yaml; in
# production point these at the external database server.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=paylink
DB_USERNAME=paylink_app
DB_PASSWORD=paylink_app
# Deploy-time migrations user (php artisan migrate --database=mariadb_migrator).
DB_MIGRATOR_USERNAME=paylink_migrator
DB_MIGRATOR_PASSWORD=paylink_migrator
# Optional TLS to an external server (paths readable by PHP).
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/paylink-db-ca.pem
# MYSQL_ATTR_SSL_CERT=
# MYSQL_ATTR_SSL_KEY=
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true
# Host port published by compose.yaml (default 33061).
# FORWARD_DB_PORT=33061

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking (Sentry or GlitchTip, ADR-029). Disabled while empty.
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

VITE_APP_NAME="${APP_NAME}"
