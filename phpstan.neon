# Larastan / PHPStan configuration.
#
# Level: max (10). The codebase is small enough at Phase 0 to be fully green at
# the strictest level, and starting there is far cheaper than raising it later
# (plan 23.5: "Larastan at the maximum viable level"). If a future package makes
# max unworkable for a specific path, prefer a targeted ignore with a reason
# over lowering the global level.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        - tests
    excludePaths:
        # Deliberate violations for the TenantTableAccessRule test.
        - tests/PHPStan/Fixtures
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false

services:
    # Plan 6.5: no DB::table()/raw SQL on tenant tables, no withoutGlobalScope(s)
    # outside the whitelist. Tables and whitelist: config/tenancy.php.
    -
        class: Tests\PHPStan\Rules\TenantTableAccessRule
        arguments:
            configPath: %currentWorkingDirectory%/config/tenancy.php
        tags:
            - phpstan.rules.rule
